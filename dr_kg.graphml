<graph edgedefault="directed"><data key="d0">DR-KG</data>
<data key="d1">1.0</data>
<node id="MA">
  <data key="d2">Lesion</data>
  <data key="d3">Microaneurysms</data>
  <data key="d4">Small saccular outpouchings of retinal capillaries; the earliest visible sign of DR.</data>
  <data key="d5">microaneurysms|few microaneurysms|small red dots of microaneurysms</data>
</node>
<node id="LOC:retinal capillaries">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">retinal capillaries</data>
</node>
<node id="MECH:pericyte loss and capillary wall weakening">
  <data key="d2">Mechanism</data>
  <data key="d3">pericyte loss and capillary wall weakening</data>
</node>
<node id="G1">
  <data key="d2">SeverityGrade</data>
  <data key="d3">Mild NPDR</data>
  <data key="d6">1</data>
  <data key="d7">Microaneurysms only</data>
</node>
<node id="HE">
  <data key="d2">Lesion</data>
  <data key="d3">Intraretinal hemorrhages</data>
  <data key="d4">Dot and blot hemorrhages within the retina.</data>
  <data key="d5">retinal haemorrhages|dot and blot haemorrhages|intraretinal hemorrhages</data>
</node>
<node id="LOC:inner retina">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">inner retina</data>
</node>
<node id="MECH:capillary rupture">
  <data key="d2">Mechanism</data>
  <data key="d3">capillary rupture</data>
</node>
<node id="G2">
  <data key="d2">SeverityGrade</data>
  <data key="d3">Moderate NPDR</data>
  <data key="d6">2</data>
  <data key="d7">More than just microaneurysms but less than severe NPDR</data>
</node>
<node id="EX">
  <data key="d2">Lesion</data>
  <data key="d3">Hard exudates</data>
  <data key="d4">Yellow lipid and protein deposits from leaking vessels.</data>
  <data key="d5">hard exudates|yellow lipid exudates|exudates near the macula</data>
</node>
<node id="LOC:outer plexiform layer, often near the macula">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">outer plexiform layer, often near the macula</data>
</node>
<node id="MECH:breakdown of the blood-retinal barrier">
  <data key="d2">Mechanism</data>
  <data key="d3">breakdown of the blood-retinal barrier</data>
</node>
<node id="CWS">
  <data key="d2">Lesion</data>
  <data key="d3">Cotton-wool spots (soft exudates)</data>
  <data key="d4">Fluffy white nerve-fibre-layer infarcts.</data>
  <data key="d5">cotton wool spots|soft exudates|white fluffy cotton wool spots</data>
</node>
<node id="LOC:retinal nerve fibre layer">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">retinal nerve fibre layer</data>
</node>
<node id="MECH:focal capillary occlusion and axoplasmic stasis">
  <data key="d2">Mechanism</data>
  <data key="d3">focal capillary occlusion and axoplasmic stasis</data>
</node>
<node id="SHE">
  <data key="d2">Lesion</data>
  <data key="d3">Extensive hemorrhages in four quadrants</data>
  <data key="d4">More than 20 intraretinal hemorrhages in each of the four quadrants (4-2-1 rule, '4').</data>
  <data key="d5">many haemorrhages in all four quadrants|extensive retinal haemorrhages|severe intraretinal haemorrhages</data>
</node>
<node id="LOC:all four retinal quadrants">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">all four retinal quadrants</data>
</node>
<node id="MECH:widespread capillary non-perfusion">
  <data key="d2">Mechanism</data>
  <data key="d3">widespread capillary non-perfusion</data>
</node>
<node id="G3">
  <data key="d2">SeverityGrade</data>
  <data key="d3">Severe NPDR</data>
  <data key="d6">3</data>
  <data key="d7">Any of: &gt;20 intraretinal haemorrhages in each of 4 quadrants; venous beading in &gt;=2 quadrants; IRMA in &gt;=1 quadrant; and no signs of PDR</data>
</node>
<node id="VB">
  <data key="d2">Lesion</data>
  <data key="d3">Venous beading</data>
  <data key="d4">Localised dilation and constriction of retinal veins (4-2-1 rule, '2': two or more quadrants).</data>
  <data key="d5">venous beading|beaded retinal veins|venous abnormalities</data>
</node>
<node id="LOC:retinal veins">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">retinal veins</data>
</node>
<node id="MECH:retinal ischaemia">
  <data key="d2">Mechanism</data>
  <data key="d3">retinal ischaemia</data>
</node>
<node id="IRMA">
  <data key="d2">Lesion</data>
  <data key="d3">Intraretinal microvascular abnormalities</data>
  <data key="d4">Shunt vessels within the retina (4-2-1 rule, '1': one or more quadrants).</data>
  <data key="d5">intraretinal microvascular abnormalities|IRMA|abnormal intraretinal vessels</data>
</node>
<node id="LOC:intraretinal capillary bed">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">intraretinal capillary bed</data>
</node>
<node id="MECH:ischaemia-driven vascular remodelling">
  <data key="d2">Mechanism</data>
  <data key="d3">ischaemia-driven vascular remodelling</data>
</node>
<node id="NV">
  <data key="d2">Lesion</data>
  <data key="d3">Neovascularisation</data>
  <data key="d4">New vessels on the disc (NVD) or elsewhere (NVE).</data>
  <data key="d5">neovascularization|new vessels on the optic disc|neovascularisation elsewhere</data>
</node>
<node id="LOC:optic disc or retinal surface">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">optic disc or retinal surface</data>
</node>
<node id="MECH:VEGF-driven angiogenesis">
  <data key="d2">Mechanism</data>
  <data key="d3">VEGF-driven angiogenesis</data>
</node>
<node id="G4">
  <data key="d2">SeverityGrade</data>
  <data key="d3">PDR</data>
  <data key="d6">4</data>
  <data key="d7">Neovascularisation and/or vitreous or preretinal haemorrhage</data>
</node>
<node id="PRH">
  <data key="d2">Lesion</data>
  <data key="d3">Preretinal or vitreous hemorrhage</data>
  <data key="d4">Bleeding in front of the retina or into the vitreous from fragile new vessels.</data>
  <data key="d5">preretinal haemorrhage|vitreous haemorrhage|boat-shaped preretinal hemorrhage</data>
</node>
<node id="LOC:preretinal space or vitreous">
  <data key="d2">AnatomicalSite</data>
  <data key="d3">preretinal space or vitreous</data>
</node>
<node id="MECH:rupture of new vessels">
  <data key="d2">Mechanism</data>
  <data key="d3">rupture of new vessels</data>
</node>
<node id="G0">
  <data key="d2">SeverityGrade</data>
  <data key="d3">No DR</data>
  <data key="d6">0</data>
  <data key="d7">No abnormalities</data>
</node>
<node id="RULE:G0">
  <data key="d2">ClinicalRule</data>
  <data key="d3">No abnormalities</data>
</node>
<node id="FU:G0">
  <data key="d2">Management</data>
  <data key="d3">12 months</data>
</node>
<node id="RULE:G1">
  <data key="d2">ClinicalRule</data>
  <data key="d3">Microaneurysms only</data>
</node>
<node id="FU:G1">
  <data key="d2">Management</data>
  <data key="d3">12 months</data>
</node>
<node id="RULE:G2">
  <data key="d2">ClinicalRule</data>
  <data key="d3">More than just microaneurysms but less than severe NPDR</data>
</node>
<node id="FU:G2">
  <data key="d2">Management</data>
  <data key="d3">6-12 months</data>
</node>
<node id="RULE:G3">
  <data key="d2">ClinicalRule</data>
  <data key="d3">Any of: &gt;20 intraretinal haemorrhages in each of 4 quadrants; venous beading in &gt;=2 quadrants; IRMA in &gt;=1 quadrant; and no signs of PDR</data>
</node>
<node id="FU:G3">
  <data key="d2">Management</data>
  <data key="d3">3-4 months; consider referral</data>
</node>
<node id="RULE:G4">
  <data key="d2">ClinicalRule</data>
  <data key="d3">Neovascularisation and/or vitreous or preretinal haemorrhage</data>
</node>
<node id="FU:G4">
  <data key="d2">Management</data>
  <data key="d3">Urgent referral; panretinal photocoagulation or anti-VEGF</data>
</node>
<node id="NEUTRAL">
  <data key="d2">Reference</data>
  <data key="d3">Normal fundus</data>
  <data key="d5">normal fundus|healthy retina|no diabetic retinopathy</data>
</node>
