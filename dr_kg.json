{
  "name": "DR-KG",
  "version": "1.0",
  "sources": [
    "ICDR scale (Wilkinson et al., Ophthalmology 2003)",
    "ETDRS 4-2-1 rule (ETDRS Report 12, Ophthalmology 1991)"
  ],
  "concepts": [
    {
      "id": "MA",
      "name": "Microaneurysms",
      "level": 1,
      "description": "Small saccular outpouchings of retinal capillaries; the earliest visible sign of DR.",
      "location": "retinal capillaries",
      "mechanism": "pericyte loss and capillary wall weakening",
      "prompts": [
        "microaneurysms",
        "few microaneurysms",
        "small red dots of microaneurysms"
      ]
    },
    {
      "id": "HE",
      "name": "Intraretinal hemorrhages",
      "level": 2,
      "description": "Dot and blot hemorrhages within the retina.",
      "location": "inner retina",
      "mechanism": "capillary rupture",
      "prompts": [
        "retinal haemorrhages",
        "dot and blot haemorrhages",
        "intraretinal hemorrhages"
      ]
    },
    {
      "id": "EX",
      "name": "Hard exudates",
      "level": 2,
      "description": "Yellow lipid and protein deposits from leaking vessels.",
      "location": "outer plexiform layer, often near the macula",
      "mechanism": "breakdown of the blood-retinal barrier",
      "prompts": [
        "hard exudates",
        "yellow lipid exudates",
        "exudates near the macula"
      ]
    },
    {
      "id": "CWS",
      "name": "Cotton-wool spots (soft exudates)",
      "level": 2,
      "description": "Fluffy white nerve-fibre-layer infarcts.",
      "location": "retinal nerve fibre layer",
      "mechanism": "focal capillary occlusion and axoplasmic stasis",
      "prompts": [
        "cotton wool spots",
        "soft exudates",
        "white fluffy cotton wool spots"
      ]
    },
    {
      "id": "SHE",
      "name": "Extensive hemorrhages in four quadrants",
      "level": 3,
      "description": "More than 20 intraretinal hemorrhages in each of the four quadrants (4-2-1 rule, '4').",
      "location": "all four retinal quadrants",
      "mechanism": "widespread capillary non-perfusion",
      "prompts": [
        "many haemorrhages in all four quadrants",
        "extensive retinal haemorrhages",
        "severe intraretinal haemorrhages"
      ]
    },
    {
      "id": "VB",
      "name": "Venous beading",
      "level": 3,
      "description": "Localised dilation and constriction of retinal veins (4-2-1 rule, '2': two or more quadrants).",
      "location": "retinal veins",
      "mechanism": "retinal ischaemia",
      "prompts": [
        "venous beading",
        "beaded retinal veins",
        "venous abnormalities"
      ]
    },
    {
      "id": "IRMA",
      "name": "Intraretinal microvascular abnormalities",
      "level": 3,
      "description": "Shunt vessels within the retina (4-2-1 rule, '1': one or more quadrants).",
      "location": "intraretinal capillary bed",
      "mechanism": "ischaemia-driven vascular remodelling",
      "prompts": [
        "intraretinal microvascular abnormalities",
        "IRMA",
        "abnormal intraretinal vessels"
      ]
    },
    {
      "id": "NV",
      "name": "Neovascularisation",
      "level": 4,
      "description": "New vessels on the disc (NVD) or elsewhere (NVE).",
      "location": "optic disc or retinal surface",
      "mechanism": "VEGF-driven angiogenesis",
      "prompts": [
        "neovascularization",
        "new vessels on the optic disc",
        "neovascularisation elsewhere"
      ]
    },
    {
      "id": "PRH",
      "name": "Preretinal or vitreous hemorrhage",
      "level": 4,
      "description": "Bleeding in front of the retina or into the vitreous from fragile new vessels.",
      "location": "preretinal space or vitreous",
      "mechanism": "rupture of new vessels",
      "prompts": [
        "preretinal haemorrhage",
        "vitreous haemorrhage",
        "boat-shaped preretinal hemorrhage"
      ]
    }
  ],
  "neutral_prompts": [
    "normal fundus",
    "healthy retina",
    "no diabetic retinopathy"
  ],
  "grades": [
    {
      "id": "G0",
      "grade": 0,
      "name": "No DR",
      "rule": "No abnormalities",
      "followup": "12 months"
    },
    {
      "id": "G1",
      "grade": 1,
      "name": "Mild NPDR",
      "rule": "Microaneurysms only",
      "followup": "12 months"
    },
    {
      "id": "G2",
      "grade": 2,
      "name": "Moderate NPDR",
      "rule": "More than just microaneurysms but less than severe NPDR",
      "followup": "6-12 months"
    },
    {
      "id": "G3",
      "grade": 3,
      "name": "Severe NPDR",
      "rule": "Any of: >20 intraretinal haemorrhages in each of 4 quadrants; venous beading in >=2 quadrants; IRMA in >=1 quadrant; and no signs of PDR",
      "followup": "3-4 months; consider referral"
    },
    {
      "id": "G4",
      "grade": 4,
      "name": "PDR",
      "rule": "Neovascularisation and/or vitreous or preretinal haemorrhage",
      "followup": "Urgent referral; panretinal photocoagulation or anti-VEGF"
    }
  ],
